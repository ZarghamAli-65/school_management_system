model Subject {
  id Int @id @default(autoincrement())

  code        String  @unique
  name        String
  shortName   String?
  description String?

  gradeLevel   String?
  category     String?

  teachers    TeacherSubject[]
  classSchedules ClassSchedule[]
  exams       Exam[]
  assignments Assignment[]
  results     Result[]

  deletedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
