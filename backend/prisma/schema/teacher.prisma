model Teacher {
  id          Int              @id @default(autoincrement())
  teacherId   String           @unique
  email       String           @unique
  photo       String?
  phone       String?
  address     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  birthday    DateTime?
  bloodType   String?
  firstName   String?
  gender      Gender?
  lastName    String?
  username    String?          @unique
  assignments Assignment[]
  exams       Exam[]
  lessons     Lesson[]
  results     Result[]
  classes     TeacherClass[]
  subjects    TeacherSubject[]
}
