enum Gender {
  MALE
  FEMALE
}

model Teacher {
  id Int @id @default(autoincrement())

  teacherId String  @unique
  username  String? @unique
  email     String  @unique

  firstName String?
  lastName  String?

  phone   String?
  address String?

  bloodType String?
  birthday  DateTime?
  gender    Gender?

  photo String?

  subjects    TeacherSubject[]
  classes     TeacherClass[]
  lessons     Lesson[]
  exams       Exam[]
  assignments Assignment[]
  results     Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
