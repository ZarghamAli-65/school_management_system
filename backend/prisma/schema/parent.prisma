model Parent {
  id Int @id @default(autoincrement())

  // Account
  email    String? @unique
  username String? @unique
  password String?

  // Personal Information
  firstName  String
  lastName   String
  photo      String?

  gender         Gender?
  dateOfBirth    DateTime?
  bloodType      String?
  nationality    String?
  maritalStatus  MaritalStatus?

  // Contact Information
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  province       String?
  country        String?
  postalCode     String?

  // Identification
  cnic       String? @unique

  //Education
  qualification   String?


  // Professional Information
  occupation      String?
  employer        String?
  jobTitle        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  students   Student[]
}