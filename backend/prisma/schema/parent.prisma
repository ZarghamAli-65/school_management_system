model Parent {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String

  firstName String
  lastName  String

  phone   String?
  address String?

  bloodType String?
  gender    Gender?
  image     String?

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
