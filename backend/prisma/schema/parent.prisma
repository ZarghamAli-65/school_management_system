model Parent {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bloodType String?
  firstName String
  gender    Gender?
  image     String?
  lastName  String
  password  String
  username  String    @unique
  cnic      String    @unique
  students  Student[]
}
