model Class {
  id Int @id @default(autoincrement())

  name String @unique

  section String?

  grade Int

  academicYear String?

  roomNo String?

  capacity Int

  supervisor String?

  students Student[]
  teachers TeacherClass[]

  lessons       Lesson[]
  exams         Exam[]
  assignments   Assignment[]
  results       Result[]
  events        Event[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
