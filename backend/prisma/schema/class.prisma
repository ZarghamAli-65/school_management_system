model Class {
  id        Int     @id @default(autoincrement())
  section   String?
  grade     Int                 // e.g., 9, 10
  academicYear String?           // e.g., "2025-2026"

  roomNo    String?
  capacity  Int                  // max students
  enrolledCount Int?             // optional cache, or compute via relation

  supervisor String?             // could be name or relation to Teacher

  deletedAt DateTime?
  isActive  Boolean?             @default(true) // maybe derived from status

  // Relations
  students      Student[]
  teachers      TeacherClass[]
  lessons       Lesson[]
  exams         Exam[]
  assignments   Assignment[]
  results       Result[]
  events        Event[]
  announcements Announcement[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}