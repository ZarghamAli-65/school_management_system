model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher?

  markedStudentAttendances StudentAttendance[]
  markedTeacherAttendances TeacherAttendance[]
}
